# On the legacy Mac, copy this file to .retrolive-legacy-build.env at the root
# of the synchronized checkout. The private copy is excluded from sync and Git.

# Quote the value when the archived Xcode filename contains spaces.
RETROLIVE_DEVELOPER_DIR='/Applications/Xcode 6.2.app/Contents/Developer'
# Each scheme gets its own child directory under this root.
RETROLIVE_DERIVED_DATA=/Users/retrolive-builder/BuildData/RetroLive
RETROLIVE_CONFIGURATION=Debug

# Use NO for an unsigned compile check. A physical-device build requires YES,
# a valid development identity, and a provisioning profile for that device.
RETROLIVE_CODE_SIGNING_ALLOWED=NO

# Optional private xcconfig stored only on the legacy Mac.
RETROLIVE_SIGNING_XCCONFIG=
