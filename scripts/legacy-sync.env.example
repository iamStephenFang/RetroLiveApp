# Copy this file to .retrolive-legacy-sync.env at the repository root and edit
# the copy. The real file is ignored by Git.

# Prefer an alias defined in ~/.ssh/config. A user@host value also works.
# Mavericks SSH compatibility options belong in that host entry, not this file;
# see docs/guides/legacy-mac-sync-build.md.
RETROLIVE_SYNC_REMOTE=retrolive-air

# Create this dedicated directory once on the legacy Mac before the first sync.
# It must be absolute and must not contain spaces.
RETROLIVE_SYNC_ROOT=/Users/your-user/Developer/RetroLive

# The same path must be set as RETROLIVE_PACKAGE_ROOT in the private build
# config on the legacy Mac. It is ignored by Git and excluded from source sync.
RETROLIVE_REMOTE_PACKAGE_ROOT=/Users/your-user/Developer/RetroLive/artifacts

# Local destination for packages fetched from the legacy Mac.
RETROLIVE_LOCAL_PACKAGE_ROOT=artifacts
