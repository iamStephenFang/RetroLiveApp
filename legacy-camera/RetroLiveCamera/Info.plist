<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleDisplayName</key><string>RetroLive Camera</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleIconFiles</key>
    <array>
        <string>RetroLiveLegacyIcon.png</string>
        <string>RetroLiveLegacyIcon@2x.png</string>
        <string>RetroLiveLegacyIcon-Small.png</string>
        <string>RetroLiveLegacyIcon-Small@2x.png</string>
        <string>RetroLiveLegacyIcon-Spotlight.png</string>
        <string>RetroLiveLegacyIcon-Spotlight@2x.png</string>
    </array>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>NSCameraUsageDescription</key><string>RetroLive uses the camera to capture local photo assets.</string>
    <key>NSMicrophoneUsageDescription</key><string>RetroLive uses the microphone to include sound with motion photos.</string>
    <key>NSLocalNetworkUsageDescription</key><string>RetroLive shares captured assets with your paired device on the local network.</string>
    <key>NSBonjourServices</key>
    <array><string>_retrolive._tcp</string></array>
    <key>UIStatusBarHidden</key><true/>
    <key>UIPrerenderedIcon</key><true/>
    <key>UIViewControllerBasedStatusBarAppearance</key><false/>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string></array>
</dict>
</plist>
