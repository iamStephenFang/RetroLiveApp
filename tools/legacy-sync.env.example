# Copy this file to .retrolive-legacy-sync.env at the repository root and edit
# the copy. The real file is ignored by Git.

# Prefer an alias defined in ~/.ssh/config. A user@host value also works.
RETROLIVE_SYNC_REMOTE=retrolive-air

# Create this dedicated directory once on the legacy Mac before the first sync.
# It must be absolute and must not contain spaces.
RETROLIVE_SYNC_ROOT=/Users/retrolive-builder/BuildMirror/RetroLive
