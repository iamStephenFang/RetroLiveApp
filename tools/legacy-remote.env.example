# Copy this file to .retrolive-legacy.env at the repository root and edit the
# copy. The real file is ignored by Git.

# Prefer an alias defined in ~/.ssh/config. A user@host value also works.
RETROLIVE_REMOTE=retrolive-air

# The source mirror and build output live outside each other. The mirror path
# must contain only shell-safe path characters because rsync passes it through
# a remote shell. Both directories must be dedicated to this script.
RETROLIVE_REMOTE_ROOT=/Users/retrolive-builder/BuildMirror/RetroLive
RETROLIVE_REMOTE_DERIVED_DATA=/Users/retrolive-builder/BuildData/RetroLive

# Point directly at the archived Xcode developer directory on the remote Mac.
# Spaces are supported when the value is quoted as a shell assignment.
RETROLIVE_REMOTE_DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer

# Debug is the normal device-development configuration.
RETROLIVE_CONFIGURATION=Debug

# Debug builds in the project disable signing for modern-host checks. Set YES
# for a physical-device build after installing a valid certificate and profile
# on the remote Mac. Set NO for an unsigned compile check.
RETROLIVE_CODE_SIGNING_ALLOWED=NO

# Optional, remote-only xcconfig for manual signing settings. Do not put the
# file, certificates, private keys, profile UUIDs, or device IDs in Git.
RETROLIVE_SIGNING_XCCONFIG=
